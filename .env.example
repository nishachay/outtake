# OUTTAKE — environment variables
#
# Copy to .env for local dev:   cp .env.example .env
# Required on Vercel (Production): DATABASE_URL, ADMIN_KEY,
#   AUTH_GITHUB_ID, AUTH_GITHUB_SECRET, AUTH_SECRET, ADMIN_GITHUB_LOGINS

# --- Database (Neon Postgres, free tier) ---
# Connection string from Neon dashboard. Used by Drizzle at runtime
# and by the import script. Absent locally -> public site uses the
# bundled catalog.json fallback (static-first).
DATABASE_URL=

# --- Admin ---
# Env-key used by CI/refresh jobs to authenticate to admin endpoints
# (Authorization: Bearer $ADMIN_KEY). Pick a long random string.
ADMIN_KEY=

# Comma-separated GitHub logins allowed to sign in as admin (e.g. "nishachay").
# Empty means ANY successfully authenticated GitHub user is allowed (not recommended).
ADMIN_GITHUB_LOGINS=

# --- Auth.js + GitHub OAuth ---
# Create a GitHub OAuth App: Settings -> Developer settings -> OAuth Apps.
# Homepage URL: https://your-app.vercel.app  Callback: https://your-app.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Set true on Vercel when behind their proxy (or set trustHost in lib/auth.ts)
AUTH_TRUST_HOST=true

# --- Optional ---
# If set, verification uses YouTube Data API v3; otherwise the keyless oEmbed probe is used.
YOUTUBE_API_KEY=